<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RGVMonitor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RG Valorant Monitor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!-- Elemento del riel lateral (estilo Microsoft Store): icono arriba, etiqueta debajo. -->
            <Style x:Key="RailItemStyle" TargetType="ListViewItem"
                   BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="50" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="RailLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="RailButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="50" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra de título integrada -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Height="48" Padding="14,0">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7EF;" FontSize="14"
                              Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="RG Valorant Monitor"
                           VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- Riel de navegación lateral -->
        <Grid x:Name="RailRoot" Grid.Row="1" Grid.Column="0" Padding="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="NavRail" Grid.Row="0"
                      SelectionMode="Single"
                      HorizontalAlignment="Center"
                      ItemContainerStyle="{StaticResource RailItemStyle}"
                      AutomationProperties.Name="Navegación"
                      SelectionChanged="NavRail_SelectionChanged">
                <ListView.Resources>
                    <!-- El indicador propio (RailIndicator) sustituye al de ListViewItem para poder deslizarlo. -->
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="Transparent" />
                </ListView.Resources>
                <!-- Iconos dibujados con trazados (lienzo 24x24) para animar sus partes.
                     Tag de cada forma: sin Tag = contorno, "fill" = relleno al seleccionar,
                     "both" = contorno + relleno, "dot" = relleno del color del contorno.
                     Ver RailIcons.cs. -->
                <ListViewItem Tag="match" AutomationProperties.Name="Partida">
                    <StackPanel Spacing="3" RenderTransformOrigin="0.5,0.5">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Canvas x:Name="MatchBack">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform />
                                    </Canvas.RenderTransform>
                                    <Ellipse Tag="both" Canvas.Left="14" Canvas.Top="5.4" Width="5.4" Height="5.4"
                                             StrokeDashArray="12 12" />
                                    <Path Data="M16.6,13.6 C19.2,13.8 21,15.8 21,19 V19.5 H17"
                                          StrokeDashArray="9 9" />
                                </Canvas>
                                <Canvas x:Name="MatchFront">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform />
                                    </Canvas.RenderTransform>
                                    <Ellipse Tag="both" Canvas.Left="5.6" Canvas.Top="4.4" Width="6.8" Height="6.8"
                                             StrokeDashArray="14 14" />
                                    <Path Tag="both"
                                          Data="M3.5,19.5 C3.5,15.8 5.9,13.6 9,13.6 C12.1,13.6 14.5,15.8 14.5,19.5 Z"
                                          StrokeDashArray="18 18" />
                                </Canvas>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Partida" Style="{StaticResource RailLabelStyle}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="skins" AutomationProperties.Name="Skins">
                    <StackPanel Spacing="3" RenderTransformOrigin="0.5,0.5">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.8">
                                <Canvas.RenderTransform>
                                    <CompositeTransform />
                                </Canvas.RenderTransform>
                                <!-- Relleno de la cesta: crece de abajo arriba al seleccionar. -->
                                <Path x:Name="SkinsCartFill" Tag="fill" Data="M5.7,6.5 H20.5 L18,14.5 H7.4 Z"
                                      RenderTransformOrigin="0.5,1">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleY="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <!-- Asa + cesta en un solo trazo. -->
                                <Path Data="M2.5,3.5 H5 L7.4,14.5 H18 L20.5,6.5 H5.7" StrokeDashArray="30 30" />
                                <Ellipse Tag="dot" Canvas.Left="7.3" Canvas.Top="17.3" Width="3.4" Height="3.4" />
                                <Ellipse Tag="dot" Canvas.Left="14.8" Canvas.Top="17.3" Width="3.4" Height="3.4" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Skins" Style="{StaticResource RailLabelStyle}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="last" AutomationProperties.Name="Partida anterior">
                    <StackPanel Spacing="3" RenderTransformOrigin="0.5,0.5">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Ellipse Tag="fill" Canvas.Left="4.5" Canvas.Top="4.5" Width="15" Height="15"
                                         Opacity="0.35" />
                                <!-- Flecha circular de "historial" -->
                                <Canvas x:Name="LastArrow">
                                    <Canvas.RenderTransform>
                                        <RotateTransform CenterX="12" CenterY="12" />
                                    </Canvas.RenderTransform>
                                    <Path Data="M5.1,8.6 A7.5,7.5 0 1 1 4.5,12" StrokeDashArray="26 26" />
                                    <Path Data="M4.8,4.6 V8.8 H9" StrokeDashArray="7 7" />
                                </Canvas>
                                <Canvas x:Name="LastHands">
                                    <Canvas.RenderTransform>
                                        <RotateTransform CenterX="12" CenterY="12" />
                                    </Canvas.RenderTransform>
                                    <Path Data="M12,8 V12 L14.6,13.6" />
                                </Canvas>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Anterior" Style="{StaticResource RailLabelStyle}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="recent" AutomationProperties.Name="Recientes">
                    <StackPanel Spacing="3" RenderTransformOrigin="0.5,0.5">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Ellipse Tag="fill" Canvas.Left="4" Canvas.Top="4" Width="16" Height="16"
                                         Opacity="0.35" />
                                <Ellipse Canvas.Left="3.6" Canvas.Top="3.6" Width="16.8" Height="16.8"
                                         StrokeDashArray="30 30" />
                                <Path x:Name="RecentMinute" Data="M12,12 V7.2">
                                    <Path.RenderTransform>
                                        <RotateTransform CenterX="12" CenterY="12" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="RecentHour" Data="M12,12 L15.2,13.8">
                                    <Path.RenderTransform>
                                        <RotateTransform CenterX="12" CenterY="12" />
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Recientes" Style="{StaticResource RailLabelStyle}" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <!-- Indicador de selección que se desliza y estira entre elementos, como en la Store. -->
            <Rectangle x:Name="RailIndicator" Grid.Row="0" Width="3" Height="16"
                       RadiusX="1.5" RadiusY="1.5"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}"
                       IsHitTestVisible="False" Opacity="0"
                       RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <CompositeTransform x:Name="RailIndicatorTransform" />
                </Rectangle.RenderTransform>
            </Rectangle>

            <Button x:Name="SoundButton" Grid.Row="1"
                    Style="{StaticResource RailButtonStyle}"
                    Click="SoundButton_Click">
                <StackPanel Spacing="3" RenderTransformOrigin="0.5,0.5">
                    <Viewbox Width="17" Height="17">
                        <Canvas x:Name="SoundIcon" Width="24" Height="24">
                            <Path x:Name="SoundSpeaker" Data="M4,9.3 H7.2 L11.6,5.6 V18.4 L7.2,14.7 H4 Z">
                                <Path.RenderTransform>
                                    <ScaleTransform CenterX="8" CenterY="12" />
                                </Path.RenderTransform>
                            </Path>
                            <Path x:Name="SoundWave1" Data="M14.6,9.4 A3.6,3.6 0 0 1 14.6,14.6">
                                <Path.RenderTransform>
                                    <ScaleTransform CenterX="12" CenterY="12" />
                                </Path.RenderTransform>
                            </Path>
                            <Path x:Name="SoundWave2" Data="M17,6.8 A7,7 0 0 1 17,17.2">
                                <Path.RenderTransform>
                                    <ScaleTransform CenterX="12" CenterY="12" />
                                </Path.RenderTransform>
                            </Path>
                            <!-- X de silencio -->
                            <Path x:Name="SoundMute" Data="M15,9.5 L20,14.5 M20,9.5 L15,14.5" Opacity="0">
                                <Path.RenderTransform>
                                    <ScaleTransform CenterX="17.5" CenterY="12" ScaleX="0.4" ScaleY="0.4" />
                                </Path.RenderTransform>
                            </Path>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="SoundLabel" Text="Sonidos" Style="{StaticResource RailLabelStyle}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Contenido: tarjeta con esquina superior izquierda redondeada, como en la Store -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
            <Frame x:Name="ContentFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <!-- Transición suave (deslizar + fundido) al cambiar de pestaña. -->
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </Border>
    </Grid>
</Window>
