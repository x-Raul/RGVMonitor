<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RGVMonitor.App.MatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RGVMonitor.App.ViewModels">

    <Grid Style="{StaticResource PageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado: una línea (título · estado · tu rango · actualizar) + marcador -->
        <StackPanel Grid.Row="0" Spacing="12">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="-16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Título con punto de estado: rojo y latiendo en selección/partida, gris en el lobby -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                        <Ellipse x:Name="LiveHalo" Width="14" Height="14" Fill="{StaticResource EnemyBrush}"
                                 Opacity="0" RenderTransformOrigin="0.5,0.5"
                                 Visibility="{x:Bind ViewModel.LiveVisibility, Mode=OneWay}">
                            <Ellipse.RenderTransform>
                                <ScaleTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource EnemyBrush}"
                                 Visibility="{x:Bind ViewModel.LiveVisibility, Mode=OneWay}" />
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                 Visibility="{x:Bind ViewModel.IdleDotVisibility, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Text="Partida en vivo" FontSize="22" FontWeight="Bold"
                               CharacterSpacing="-10" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Padding="10,3" CornerRadius="10" VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <!-- Buscando partida desde el lobby: tipo de cola y tiempo que llevas. -->
                    <Border Padding="10,3,11,4" CornerRadius="10" VerticalAlignment="Center"
                            Background="#264C97ED" BorderBrush="#664C97ED" BorderThickness="1"
                            Visibility="{x:Bind ViewModel.QueueVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.QueueLabel, Mode=OneWay}" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.QueueElapsed, Mode=OneWay}" FontSize="13"
                                       FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{x:Bind ViewModel.QueueTimeBrush, Mode=OneWay}"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tu rango: emblema + nombre + barrita de RR. En cian con flecha si estás
                     a una victoria de subir. -->
                <Grid Grid.Column="2" VerticalAlignment="Center"
                      Visibility="{x:Bind ViewModel.SelfRankVisibility, Mode=OneWay}">
                    <Border CornerRadius="10" BorderThickness="1"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.SelfRankNormalVisibility, Mode=OneWay}" />
                    <Border CornerRadius="10" BorderThickness="1"
                            Background="{StaticResource RankUpFillBrush}"
                            BorderBrush="{StaticResource RankUpBrush}"
                            Visibility="{x:Bind ViewModel.SelfRankUpVisibility, Mode=OneWay}" />
                    <Grid Padding="8,5,14,5" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{x:Bind ViewModel.SelfRankIcon, Mode=OneWay}"
                               Width="30" Height="30" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="TU RANGO" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.SelfRankNormalVisibility, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="4"
                                        Visibility="{x:Bind ViewModel.SelfRankUpVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE74A;" FontSize="9" FontWeight="Bold"
                                          Foreground="{StaticResource RankUpBrush}" />
                                <TextBlock Text="A UNA VICTORIA" FontSize="10" FontWeight="SemiBold"
                                           CharacterSpacing="60" Foreground="{StaticResource RankUpBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SelfRankName, Mode=OneWay}"
                                       FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5" Margin="4,0,0,0">
                            <TextBlock Text="{x:Bind ViewModel.SelfRankDetail, Mode=OneWay}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Typography.NumeralAlignment="Tabular" />
                            <ProgressBar Width="96" Minimum="0" Maximum="100"
                                         Value="{x:Bind ViewModel.SelfRrProgress, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                    <Button Command="{x:Bind ViewModel.RefreshCommand}"
                            Click="OnRefreshClicked"
                            AutomationProperties.Name="Actualizar partida">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Actualizar" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Marcador: Aliados (izq.) · probabilidad (centro) · Enemigos (der.).
                 Cada lado lleva un degradado de su color que se apaga hacia el centro. -->
            <Border Style="{StaticResource SurfaceCardStyle}"
                    Visibility="{x:Bind ViewModel.AllySummaryVisibility, Mode=OneWay}">
                <Grid CornerRadius="11">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#384C97ED" Offset="0" />
                                <GradientStop Color="#0A4C97ED" Offset="0.32" />
                                <GradientStop Color="#004C97ED" Offset="0.5" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource AllyBrush}" />
                    <Rectangle Visibility="{x:Bind ViewModel.EnemySummaryVisibility, Mode=OneWay}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00EE4D4D" Offset="0.5" />
                                <GradientStop Color="#0AEE4D4D" Offset="0.68" />
                                <GradientStop Color="#38EE4D4D" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="3" HorizontalAlignment="Right" Fill="{StaticResource EnemyBrush}"
                               Visibility="{x:Bind ViewModel.EnemySummaryVisibility, Mode=OneWay}" />

                    <Grid Padding="22,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Aliados -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Left">
                            <Grid Width="54" Height="54" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Rango medio (sin contar Unranked)">
                                <Ellipse Fill="#264C97ED" Stroke="#994C97ED" StrokeThickness="1.5" />
                                <Image Source="{x:Bind ViewModel.AllySummary.RankIcon, Mode=OneWay}" Width="36" Height="36" />
                            </Grid>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="Bold" CharacterSpacing="80"
                                           Foreground="{StaticResource AllyBrush}">
                                    <Run Text="ALIADOS" /><Run Text="  ·  " /><Run Text="{x:Bind ViewModel.AllySummary.PlayerCount, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind ViewModel.AllySummary.RankName, Mode=OneWay}"
                                           FontSize="19" FontWeight="Bold" CharacterSpacing="-10" />
                            </StackPanel>
                            <Border Style="{StaticResource StatTrayStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Style="{StaticResource StatCellStyle}">
                                        <TextBlock Text="{x:Bind ViewModel.AllySummary.Kd, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.AllySummary.KdBrush, Mode=OneWay}"
                                                   Style="{StaticResource StatFigureTextStyle}" />
                                        <TextBlock Text="KD" Style="{StaticResource StatLabelTextStyle}" />
                                    </StackPanel>
                                    <Rectangle Style="{StaticResource StatDividerStyle}" />
                                    <StackPanel Style="{StaticResource StatCellStyle}">
                                        <TextBlock Text="{x:Bind ViewModel.AllySummary.Hs, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.AllySummary.HsBrush, Mode=OneWay}"
                                                   Style="{StaticResource StatFigureTextStyle}" />
                                        <TextBlock Text="HS" Style="{StaticResource StatLabelTextStyle}" />
                                    </StackPanel>
                                    <Rectangle Style="{StaticResource StatDividerStyle}" />
                                    <StackPanel Style="{StaticResource StatCellStyle}">
                                        <TextBlock Text="{x:Bind ViewModel.AllySummary.Wr, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.AllySummary.WrBrush, Mode=OneWay}"
                                                   Style="{StaticResource StatFigureTextStyle}" />
                                        <TextBlock Text="WR" Style="{StaticResource StatLabelTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Probabilidad de victoria: 60 % [azul|rojo] 40 % -->
                        <Grid Grid.Column="1" Width="320" VerticalAlignment="Center"
                              Visibility="{x:Bind ViewModel.WinProbVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.WinProbAlly, Mode=OneWay}"
                                       Style="{StaticResource SummaryFigureTextStyle}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource AllyBrush}" />
                            <StackPanel Grid.Column="1" Spacing="7" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="PROB. DE VICTORIA" FontSize="10" FontWeight="SemiBold"
                                           CharacterSpacing="80" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="{x:Bind ViewModel.WinProbNormalVisibility, Mode=OneWay}" />
                                <!-- Menos de un 25 %: aviso en rojo -->
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.WinProbLowVisibility, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{StaticResource EnemyBrush}" />
                                    <TextBlock Text="Probabilidad muy baja" Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource EnemyBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <!-- Barra enfrentada: azul = aliados, rojo = enemigos; marca en el 50 % -->
                                <Grid Height="8" CornerRadius="4" Background="{StaticResource EnemyBrush}">
                                    <Rectangle Fill="{StaticResource AllyBrush}">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="WinBarScale" ScaleX="0.5" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Height="4" VerticalAlignment="Top" Fill="#22FFFFFF" />
                                    <Rectangle Width="2" HorizontalAlignment="Center" Fill="#99000000" />
                                </Grid>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.WinProbEnemy, Mode=OneWay}"
                                       Style="{StaticResource SummaryFigureTextStyle}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource EnemyBrush}" />
                        </Grid>

                        <!-- Enemigos (en espejo) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Right"
                                    Visibility="{x:Bind ViewModel.EnemySummaryVisibility, Mode=OneWay}">
                            <Border Style="{StaticResource StatTrayStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Style="{StaticResource StatCellStyle}">
                                        <TextBlock Text="{x:Bind ViewModel.EnemySummary.Kd, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.EnemySummary.KdBrush, Mode=OneWay}"
                                                   Style="{StaticResource StatFigureTextStyle}" />
                                        <TextBlock Text="KD" Style="{StaticResource StatLabelTextStyle}" />
                                    </StackPanel>
                                    <Rectangle Style="{StaticResource StatDividerStyle}" />
                                    <StackPanel Style="{StaticResource StatCellStyle}">
                                        <TextBlock Text="{x:Bind ViewModel.EnemySummary.Hs, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.EnemySummary.HsBrush, Mode=OneWay}"
                                                   Style="{StaticResource StatFigureTextStyle}" />
                                        <TextBlock Text="HS" Style="{StaticResource StatLabelTextStyle}" />
                                    </StackPanel>
                                    <Rectangle Style="{StaticResource StatDividerStyle}" />
                                    <StackPanel Style="{StaticResource StatCellStyle}">
                                        <TextBlock Text="{x:Bind ViewModel.EnemySummary.Wr, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.EnemySummary.WrBrush, Mode=OneWay}"
                                                   Style="{StaticResource StatFigureTextStyle}" />
                                        <TextBlock Text="WR" Style="{StaticResource StatLabelTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="Bold" CharacterSpacing="80"
                                           HorizontalAlignment="Right" Foreground="{StaticResource EnemyBrush}">
                                    <Run Text="ENEMIGOS" /><Run Text="  ·  " /><Run Text="{x:Bind ViewModel.EnemySummary.PlayerCount, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind ViewModel.EnemySummary.RankName, Mode=OneWay}"
                                           FontSize="19" FontWeight="Bold" CharacterSpacing="-10"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                            <Grid Width="54" Height="54" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Rango medio (sin contar Unranked)">
                                <Ellipse Fill="#26EE4D4D" Stroke="#99EE4D4D" StrokeThickness="1.5" />
                                <Image Source="{x:Bind ViewModel.EnemySummary.RankIcon, Mode=OneWay}" Width="36" Height="36" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Tarjeta con la tabla -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabecera de columnas (mismas columnas que la fila) -->
                <Border Grid.Row="0" Style="{StaticResource TableHeaderStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="JUGADOR" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="RANGO" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="PEAK" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="KD" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Bajas / muertes en competitivo reciente" />
                        <TextBlock Grid.Column="6" Text="HS" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Porcentaje de disparos a la cabeza" />
                        <TextBlock Grid.Column="7" Text="WR" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Porcentaje de victorias en el acto" />
                        <TextBlock Grid.Column="8" Text="PARTIDAS" Style="{StaticResource NumericColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="9" Text="NIVEL" Style="{StaticResource NumericColumnHeaderTextStyle}" />
                    </Grid>
                </Border>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Players, Mode=OneWay}"
                          SelectionMode="None" Padding="6"
                          ItemContainerStyle="{StaticResource TableItemContainerStyle}">
                    <!-- Filas que entran escalonadas según llegan los datos y se reacomodan
                         suave al ordenar aliados/enemigos. -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ReorderThemeTransition />
                            <ContentThemeTransition />
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlayerRowViewModel">
                            <Grid Padding="14,5" ColumnSpacing="10"
                                  Background="{x:Bind RowBackground}" CornerRadius="6"
                                  PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited">
                                <!-- Hover: eleva (sombra) y hace un pequeño zoom. -->
                                <Grid.ScaleTransition>
                                    <Vector3Transition Duration="0:0:0.16" />
                                </Grid.ScaleTransition>
                                <Grid.TranslationTransition>
                                    <Vector3Transition Duration="0:0:0.16" />
                                </Grid.TranslationTransition>
                                <Grid.Shadow>
                                    <ThemeShadow />
                                </Grid.Shadow>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0" Style="{StaticResource TeamStripeStyle}"
                                           Fill="{x:Bind TeamBrush}" />

                                <!-- Agente (el nombre va debajo del jugador) -->
                                <Border Grid.Column="1" Style="{StaticResource AvatarBorderStyle}"
                                        ToolTipService.ToolTip="{x:Bind AgentName}">
                                    <Image Source="{x:Bind AgentIcon}" Stretch="UniformToFill" />
                                </Border>

                                <!-- Jugador: nombre, agente, "ya visto" y marca/nota -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource PlayerNameTextStyle}"
                                                   Visibility="{x:Bind NormalNameVisibility}"
                                                   ToolTipService.ToolTip="Clic para copiar el nombre"
                                                   Tapped="OnCopyName" />
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource HiddenPlayerNameTextStyle}"
                                                   Visibility="{x:Bind HiddenNameVisibility}"
                                                   ToolTipService.ToolTip="Nombre oculto · clic para copiarlo"
                                                   Tapped="OnCopyName" />
                                    </Grid>
                                    <!-- Vandal / Phantom sin skin -->
                                    <FontIcon Glyph="&#xE7BA;" FontSize="13" VerticalAlignment="Center"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                              Visibility="{x:Bind NoSkinVisibility, Mode=OneWay}"
                                              ToolTipService.ToolTip="{x:Bind NoSkinWarning, Mode=OneWay}"
                                              AutomationProperties.Name="{x:Bind NoSkinWarning, Mode=OneWay}" />
                                    </StackPanel>
                                    <!-- Segunda línea compacta: agente · "ya visto" · marca/nota -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind AgentName}" Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                    <!-- Ya jugué con/contra él: veces + bando, cuándo (naranja si <48 h) y qué llevaba -->
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                Visibility="{x:Bind SeenVisibility, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind SeenText, Mode=OneWay}">
                                        <Border Style="{StaticResource SeenChipStyle}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{x:Bind SeenSideBrush, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE716;" FontSize="10" VerticalAlignment="Center"
                                                          Foreground="{x:Bind SeenSideBrush, Mode=OneWay}" />
                                                <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <Run Text="{x:Bind SeenCount, Mode=OneWay}" />
                                                    <Run Text="{x:Bind SeenSide, Mode=OneWay}"
                                                         Foreground="{x:Bind SeenSideBrush, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SeenChipStyle}"
                                                Background="{x:Bind SeenWhenBackground, Mode=OneWay}"
                                                BorderBrush="{x:Bind SeenWhenBorder, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE823;" FontSize="10" VerticalAlignment="Center"
                                                          Foreground="{x:Bind SeenWhenForeground, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind SeenWhen, Mode=OneWay}" FontSize="11"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{x:Bind SeenWhenForeground, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{x:Bind SeenDetail, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}">
                                        <Border Style="{StaticResource NoteChipStyle}"
                                                Background="{x:Bind NoteBrush, Mode=OneWay}"
                                                Visibility="{x:Bind NoteChipVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind NoteLabel, Mode=OneWay}"
                                                       FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{x:Bind NoteText, Mode=OneWay}"
                                                   Visibility="{x:Bind NoteTextVisibility, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                                                   ToolTipService.ToolTip="{x:Bind NoteText, Mode=OneWay}" />
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Rango actual + RR (y lo que falta para subir) -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Source="{x:Bind RankIcon}" Width="26" Height="26" />
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind RankName}" FontWeight="SemiBold" />
                                            <!-- A una victoria de subir -->
                                            <FontIcon Glyph="&#xE74A;" FontSize="12" FontWeight="Bold"
                                                      Foreground="{StaticResource RankUpBrush}"
                                                      Visibility="{x:Bind RankUpVisibility}"
                                                      ToolTipService.ToolTip="A una victoria de subir de rango" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind RrCaption}" Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{x:Bind RrCaptionBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Peak: rango + season -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Source="{x:Bind PeakIcon}" Width="24" Height="24" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind PeakName}" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind PeakSeason}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="5" Text="{x:Bind Kd}" Foreground="{x:Bind KdBrush}"
                                           Style="{StaticResource StatTextStyle}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind Hs}" Foreground="{x:Bind HsBrush}"
                                           Style="{StaticResource StatTextStyle}" />
                                <TextBlock Grid.Column="7" Text="{x:Bind Wr}" Foreground="{x:Bind WrBrush}"
                                           Style="{StaticResource StatTextStyle}" />
                                <TextBlock Grid.Column="8" Text="{x:Bind GamesPlayed}" Style="{StaticResource MutedStatTextStyle}" />
                                <TextBlock Grid.Column="9" Text="{x:Bind Level}" Style="{StaticResource MutedStatTextStyle}" />

                                <Button Grid.Column="10" Click="OnNotePlayer"
                                        Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="Marcar o anotar jugador"
                                        ToolTipService.ToolTip="Marcar / nota">
                                    <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Estado vacío (se muestra desde el code-behind cuando no hay filas) -->
                <!-- Radar: anillos que se expanden, icono flotando y puntos de "buscando" (animado en code-behind) -->
                <StackPanel x:Name="EmptyState" Grid.Row="1" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="140" Height="140" Margin="0,0,0,2">
                        <Ellipse x:Name="RadarRing1" Width="72" Height="72" Stroke="{StaticResource AllyBrush}"
                                 StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="RadarRing2" Width="72" Height="72" Stroke="{StaticResource AllyBrush}"
                                 StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="RadarRing3" Width="72" Height="72" Stroke="{StaticResource AllyBrush}"
                                 StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="RadarCore" Width="72" Height="72" Fill="#1F4C97ED"
                                 Stroke="#594C97ED" StrokeThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                        </Ellipse>
                        <FontIcon x:Name="RadarIcon" Glyph="&#xE7FC;" FontSize="30"
                                  Foreground="{StaticResource AllyBrush}" Opacity="0.9">
                            <FontIcon.RenderTransform><TranslateTransform /></FontIcon.RenderTransform>
                        </FontIcon>
                    </Grid>
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IdleVisibility, Mode=OneWay}">
                        <TextBlock Text="Sin partida activa" Style="{StaticResource EmptyStateTitleStyle}" />
                        <TextBlock Text="Los jugadores aparecerán aquí en cuanto entres en la selección de agente."
                                   Style="{StaticResource EmptyStateBodyStyle}" />
                    </StackPanel>
                    <!-- Buscando partida: contador grande que cambia de color si la cola se alarga. -->
                    <TextBlock Text="{x:Bind ViewModel.QueueElapsed, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.QueueVisibility, Mode=OneWay}"
                               Foreground="{x:Bind ViewModel.QueueTimeBrush, Mode=OneWay}"
                               FontSize="44" FontWeight="Bold" CharacterSpacing="-20"
                               Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,6,0,0">
                        <TextBlock Text="Esperando" Style="{StaticResource CaptionTextStyle}"
                                   Visibility="{x:Bind ViewModel.IdleVisibility, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.QueueLabel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}"
                                   Visibility="{x:Bind ViewModel.QueueVisibility, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                        <Ellipse x:Name="RadarDot1" Width="4" Height="4" Fill="{StaticResource AllyBrush}"
                                 Opacity="0.25" VerticalAlignment="Center" />
                        <Ellipse x:Name="RadarDot2" Width="4" Height="4" Fill="{StaticResource AllyBrush}"
                                 Opacity="0.25" VerticalAlignment="Center" />
                        <Ellipse x:Name="RadarDot3" Width="4" Height="4" Fill="{StaticResource AllyBrush}"
                                 Opacity="0.25" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <!-- Leyenda al pie de la tabla: secundaria, no compite con los datos -->
                <Border Grid.Row="2" Style="{StaticResource TableFooterStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{StaticResource AllyBrush}" />
                            <TextBlock Text="Aliado" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{StaticResource EnemyBrush}" />
                            <TextBlock Text="Enemigo" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <!-- Filas resaltadas: cuadrado con el tinte de la fila -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource LegendSwatchStyle}" Background="#30EBD73C" BorderBrush="{StaticResource SelfBrush}" />
                            <TextBlock Text="Tú" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource LegendSwatchStyle}" Background="#2846C86E" BorderBrush="{StaticResource PartyBrush}" />
                            <TextBlock Text="Tu grupo" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE74A;" FontSize="11" FontWeight="Bold"
                                      Foreground="{StaticResource RankUpBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="A una victoria de subir" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource LegendSwatchStyle}" Background="{StaticResource RecentSeenFillBrush}"
                                    BorderBrush="{StaticResource RecentSeenBrush}" />
                            <TextBlock Text="Te tocó en las últimas 48 h" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <!-- Nombre oculto: muestra de texto en su color -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Nombre" FontSize="11" Style="{StaticResource HiddenPlayerNameTextStyle}" />
                            <TextBlock Text="= oculto (incógnito)" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Aviso breve al copiar un nombre. -->
        <InfoBar x:Name="CopyToast" Grid.Row="1" Severity="Success" IsClosable="True"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,24" MaxWidth="360" />
    </Grid>
</Page>
