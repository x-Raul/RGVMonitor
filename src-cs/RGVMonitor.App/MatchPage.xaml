<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RGVMonitor.App.MatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RGVMonitor.App.ViewModels">

    <Grid Style="{StaticResource PageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Spacing="14">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="-16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Partida en vivo" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Width="20" Height="20" />
                    <Button Command="{x:Bind ViewModel.RefreshCommand}"
                            Click="OnRefreshClicked"
                            AutomationProperties.Name="Actualizar partida"
                            ToolTipService.ToolTip="Volver a cargar la partida">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Actualizar" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Resumen en una sola fila: tu rango · medias por equipo · probabilidad -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="520" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Visibility="{x:Bind ViewModel.SelfRankVisibility, Mode=OneWay}">
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="16,12"
                            Visibility="{x:Bind ViewModel.SelfRankNormalVisibility, Mode=OneWay}">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Tu rango" Style="{StaticResource CardLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelfRankCaption, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <!-- A una victoria de subir: tarjeta en azul con flecha -->
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="16,12"
                            Background="{StaticResource RankUpFillBrush}"
                            BorderBrush="{StaticResource RankUpBrush}"
                            Visibility="{x:Bind ViewModel.SelfRankUpVisibility, Mode=OneWay}">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74A;" FontSize="12" FontWeight="Bold"
                                          Foreground="{StaticResource RankUpBrush}" />
                                <TextBlock Text="Tu rango · a una victoria de subir"
                                           Style="{StaticResource CardLabelTextStyle}"
                                           Foreground="{StaticResource RankUpBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SelfRankCaption, Mode=OneWay}"
                                       FontWeight="SemiBold" Foreground="{StaticResource RankUpBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Media por equipo (aliados / enemigos) -->
                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.TeamSummaries, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeamSummaryViewModel">
                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="14,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Style="{StaticResource TeamStripeStyle}"
                                               Fill="{x:Bind TeamBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardLabelTextStyle}"
                                                       Foreground="{x:Bind TeamBrush}" />
                                            <TextBlock Text="{x:Bind PlayerCount}" Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    ToolTipService.ToolTip="Rango medio (sin contar Unranked)">
                                            <Image Source="{x:Bind RankIcon}" Width="22" Height="22" />
                                            <TextBlock Text="{x:Bind RankName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="KD" Style="{StaticResource NumericColumnHeaderTextStyle}" />
                                        <TextBlock Text="{x:Bind Kd}" Foreground="{x:Bind KdBrush}" Style="{StaticResource StatTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="HS" Style="{StaticResource NumericColumnHeaderTextStyle}" />
                                        <TextBlock Text="{x:Bind Hs}" Foreground="{x:Bind HsBrush}" Style="{StaticResource StatTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="WR" Style="{StaticResource NumericColumnHeaderTextStyle}" />
                                        <TextBlock Text="{x:Bind Wr}" Foreground="{x:Bind WrBrush}" Style="{StaticResource StatTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Probabilidad: % aliado | barra | % enemigo -->
                <Grid Grid.Column="2" Visibility="{x:Bind ViewModel.WinProbVisibility, Mode=OneWay}">
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="16,12">
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Probabilidad de victoria" Style="{StaticResource CardLabelTextStyle}"
                                   Visibility="{x:Bind ViewModel.WinProbNormalVisibility, Mode=OneWay}" />
                        <!-- Menos de un 25 %: aviso en rojo -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    Visibility="{x:Bind ViewModel.WinProbLowVisibility, Mode=OneWay}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource EnemyBrush}" />
                            <TextBlock Text="Probabilidad de victoria muy baja"
                                       Style="{StaticResource CardLabelTextStyle}"
                                       Foreground="{StaticResource EnemyBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.WinProbAlly, Mode=OneWay}"
                                       Style="{StaticResource SummaryFigureTextStyle}"
                                       Foreground="{StaticResource AllyBrush}"
                                       ToolTipService.ToolTip="Aliados" />
                            <ProgressBar x:Name="WinBar" Grid.Column="1" Maximum="100" MinHeight="6"
                                         MinWidth="120" CornerRadius="3" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.WinProbEnemy, Mode=OneWay}"
                                       Style="{StaticResource SummaryFigureTextStyle}"
                                       Foreground="{StaticResource EnemyBrush}"
                                       ToolTipService.ToolTip="Enemigos" />
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Tinte rojo encima de la tarjeta cuando la probabilidad es muy baja -->
                <Border CornerRadius="12" BorderThickness="1.5" IsHitTestVisible="False"
                        Background="#26EE4D4D" BorderBrush="{StaticResource EnemyBrush}"
                        Visibility="{x:Bind ViewModel.WinProbLowVisibility, Mode=OneWay}" />
                </Grid>
            </Grid>
        </StackPanel>

        <!-- Tarjeta con la tabla -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabecera de columnas (mismas columnas que la fila) -->
                <Border Grid.Row="0" Style="{StaticResource TableHeaderStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="JUGADOR" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="RANGO" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="PEAK" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="KD" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Bajas / muertes en competitivo reciente" />
                        <TextBlock Grid.Column="6" Text="HS" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Porcentaje de disparos a la cabeza" />
                        <TextBlock Grid.Column="7" Text="WR" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Porcentaje de victorias en el acto" />
                        <TextBlock Grid.Column="8" Text="PARTIDAS" Style="{StaticResource NumericColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="9" Text="NIVEL" Style="{StaticResource NumericColumnHeaderTextStyle}" />
                    </Grid>
                </Border>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Players, Mode=OneWay}"
                          SelectionMode="None" Padding="6"
                          ItemContainerStyle="{StaticResource TableItemContainerStyle}">
                    <!-- Filas que entran escalonadas según llegan los datos y se reacomodan
                         suave al ordenar aliados/enemigos. -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ReorderThemeTransition />
                            <ContentThemeTransition />
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlayerRowViewModel">
                            <Grid Padding="16,8" ColumnSpacing="10"
                                  Background="{x:Bind RowBackground}" CornerRadius="6"
                                  PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited">
                                <!-- Hover: eleva (sombra) y hace un pequeño zoom. -->
                                <Grid.ScaleTransition>
                                    <Vector3Transition Duration="0:0:0.16" />
                                </Grid.ScaleTransition>
                                <Grid.TranslationTransition>
                                    <Vector3Transition Duration="0:0:0.16" />
                                </Grid.TranslationTransition>
                                <Grid.Shadow>
                                    <ThemeShadow />
                                </Grid.Shadow>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0" Style="{StaticResource TeamStripeStyle}"
                                           Fill="{x:Bind TeamBrush}" />

                                <!-- Agente (el nombre va debajo del jugador) -->
                                <Border Grid.Column="1" Style="{StaticResource AvatarBorderStyle}"
                                        ToolTipService.ToolTip="{x:Bind AgentName}">
                                    <Image Source="{x:Bind AgentIcon}" Stretch="UniformToFill" />
                                </Border>

                                <!-- Jugador: nombre, agente, "ya visto" y marca/nota -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource PlayerNameTextStyle}"
                                                   Visibility="{x:Bind NormalNameVisibility}"
                                                   ToolTipService.ToolTip="Clic para copiar el nombre"
                                                   Tapped="OnCopyName" />
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource HiddenPlayerNameTextStyle}"
                                                   Visibility="{x:Bind HiddenNameVisibility}"
                                                   ToolTipService.ToolTip="Nombre oculto · clic para copiarlo"
                                                   Tapped="OnCopyName" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind AgentName}" Style="{StaticResource CaptionTextStyle}" />
                                    <!-- Ya jugué con/contra él: veces + bando, cuándo (naranja si <48 h) y qué llevaba -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                                                Visibility="{x:Bind SeenVisibility, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind SeenText, Mode=OneWay}">
                                        <Border Style="{StaticResource SeenChipStyle}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{x:Bind SeenSideBrush, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE716;" FontSize="10" VerticalAlignment="Center"
                                                          Foreground="{x:Bind SeenSideBrush, Mode=OneWay}" />
                                                <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <Run Text="{x:Bind SeenCount, Mode=OneWay}" />
                                                    <Run Text="{x:Bind SeenSide, Mode=OneWay}"
                                                         Foreground="{x:Bind SeenSideBrush, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SeenChipStyle}"
                                                Background="{x:Bind SeenWhenBackground, Mode=OneWay}"
                                                BorderBrush="{x:Bind SeenWhenBorder, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE823;" FontSize="10" VerticalAlignment="Center"
                                                          Foreground="{x:Bind SeenWhenForeground, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind SeenWhen, Mode=OneWay}" FontSize="11"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{x:Bind SeenWhenForeground, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{x:Bind SeenDetail, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}">
                                        <Border Style="{StaticResource NoteChipStyle}"
                                                Background="{x:Bind NoteBrush, Mode=OneWay}"
                                                Visibility="{x:Bind NoteChipVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind NoteLabel, Mode=OneWay}"
                                                       FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{x:Bind NoteText, Mode=OneWay}"
                                                   Visibility="{x:Bind NoteTextVisibility, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                                                   ToolTipService.ToolTip="{x:Bind NoteText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Rango actual + RR (y lo que falta para subir) -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Source="{x:Bind RankIcon}" Width="30" Height="30" />
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind RankName}" FontWeight="SemiBold" />
                                            <!-- A una victoria de subir -->
                                            <FontIcon Glyph="&#xE74A;" FontSize="12" FontWeight="Bold"
                                                      Foreground="{StaticResource RankUpBrush}"
                                                      Visibility="{x:Bind RankUpVisibility}"
                                                      ToolTipService.ToolTip="A una victoria de subir de rango" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind RrCaption}" Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{x:Bind RrCaptionBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Peak: rango + season -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Source="{x:Bind PeakIcon}" Width="24" Height="24" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind PeakName}" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind PeakSeason}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="5" Text="{x:Bind Kd}" Foreground="{x:Bind KdBrush}"
                                           Style="{StaticResource StatTextStyle}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind Hs}" Foreground="{x:Bind HsBrush}"
                                           Style="{StaticResource StatTextStyle}" />
                                <TextBlock Grid.Column="7" Text="{x:Bind Wr}" Foreground="{x:Bind WrBrush}"
                                           Style="{StaticResource StatTextStyle}" />
                                <TextBlock Grid.Column="8" Text="{x:Bind GamesPlayed}" Style="{StaticResource MutedStatTextStyle}" />
                                <TextBlock Grid.Column="9" Text="{x:Bind Level}" Style="{StaticResource MutedStatTextStyle}" />

                                <Button Grid.Column="10" Click="OnNotePlayer"
                                        Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="Marcar o anotar jugador"
                                        ToolTipService.ToolTip="Marcar / nota">
                                    <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Estado vacío (se muestra desde el code-behind cuando no hay filas) -->
                <StackPanel x:Name="EmptyState" Grid.Row="1" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7FC;" FontSize="36" Opacity="0.4" Margin="0,0,0,4" />
                    <TextBlock Text="Sin partida activa" Style="{StaticResource EmptyStateTitleStyle}" />
                    <TextBlock Text="Los jugadores aparecerán aquí en cuanto entres en la selección de agente."
                               Style="{StaticResource EmptyStateBodyStyle}" />
                </StackPanel>
                <!-- Leyenda al pie de la tabla: secundaria, no compite con los datos -->
                <Border Grid.Row="2" Style="{StaticResource TableFooterStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{StaticResource AllyBrush}" />
                            <TextBlock Text="Aliado" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{StaticResource EnemyBrush}" />
                            <TextBlock Text="Enemigo" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <!-- Filas resaltadas: cuadrado con el tinte de la fila -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource LegendSwatchStyle}" Background="#30EBD73C" BorderBrush="{StaticResource SelfBrush}" />
                            <TextBlock Text="Tú" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource LegendSwatchStyle}" Background="#2846C86E" BorderBrush="{StaticResource PartyBrush}" />
                            <TextBlock Text="Tu grupo" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE74A;" FontSize="11" FontWeight="Bold"
                                      Foreground="{StaticResource RankUpBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="A una victoria de subir" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource LegendSwatchStyle}" Background="{StaticResource RecentSeenFillBrush}"
                                    BorderBrush="{StaticResource RecentSeenBrush}" />
                            <TextBlock Text="Te tocó en las últimas 48 h" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <!-- Nombre oculto: muestra de texto en su color -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Nombre" FontSize="11" Style="{StaticResource HiddenPlayerNameTextStyle}" />
                            <TextBlock Text="= oculto (incógnito)" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Aviso breve al copiar un nombre. -->
        <InfoBar x:Name="CopyToast" Grid.Row="1" Severity="Success" IsClosable="True"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,24" MaxWidth="360" />
    </Grid>
</Page>
