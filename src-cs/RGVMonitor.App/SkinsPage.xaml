<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RGVMonitor.App.SkinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RGVMonitor.App.ViewModels">

    <Grid Style="{StaticResource PageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="-16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <TextBlock Text="Skins" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource TableHeaderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="JUGADOR" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="VANDAL" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="PHANTOM" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="SHERIFF" Style="{StaticResource ColumnHeaderTextStyle}" />
                    </Grid>
                </Border>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                          SelectionMode="None" Padding="6"
                          ItemContainerStyle="{StaticResource TableItemContainerStyle}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ContentThemeTransition />
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkinRowViewModel">
                            <Grid Padding="16,8" ColumnSpacing="12" CornerRadius="6"
                                  PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited">
                                <Grid.ScaleTransition>
                                    <Vector3Transition Duration="0:0:0.16" />
                                </Grid.ScaleTransition>
                                <Grid.TranslationTransition>
                                    <Vector3Transition Duration="0:0:0.16" />
                                </Grid.TranslationTransition>
                                <Grid.Shadow>
                                    <ThemeShadow />
                                </Grid.Shadow>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Style="{StaticResource TeamStripeStyle}"
                                           Fill="{x:Bind TeamBrush}" />
                                <Border Grid.Column="1" Style="{StaticResource AvatarBorderStyle}">
                                    <Image Source="{x:Bind AgentIcon}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{x:Bind Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind Name}" />
                                <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                    <Image Source="{x:Bind VandalIcon}" Height="34" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind VandalName}" Style="{StaticResource CaptionTextStyle}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center">
                                    <Image Source="{x:Bind PhantomIcon}" Height="34" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind PhantomName}" Style="{StaticResource CaptionTextStyle}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Spacing="2" VerticalAlignment="Center">
                                    <Image Source="{x:Bind SheriffIcon}" Height="34" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind SheriffName}" Style="{StaticResource CaptionTextStyle}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
