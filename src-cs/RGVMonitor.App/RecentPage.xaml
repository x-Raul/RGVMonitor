<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RGVMonitor.App.RecentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RGVMonitor.App.ViewModels">

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="-16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <TextBlock Text="Jugadores recientes" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     PlaceholderText="Nombre del jugador…"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchKeyDown" />
            <Button Grid.Column="1" Content="Buscar" Style="{ThemeResource AccentButtonStyle}"
                    Click="OnSearchClicked"
                    Command="{x:Bind ViewModel.SearchCommand}" />
            <ProgressRing Grid.Column="2" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="22" Height="22" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Matches, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentMatchViewModel">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Margin="0,0,0,10">
                            <Expander.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="20" />
                                </TransitionCollection>
                            </Expander.Transitions>
                            <Expander.Header>
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="15"
                                                   Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                                   Visibility="{x:Bind NormalNameVisibility}" />
                                        <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="15"
                                                   Foreground="#FFF5C83C"
                                                   Visibility="{x:Bind HiddenNameVisibility}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind TimesSeen}" Opacity="0.6"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Ahora:" Opacity="0.6" VerticalAlignment="Center" />
                                        <Image Source="{x:Bind CurrentRankIcon}" Width="24" Height="24" />
                                        <TextBlock Text="{x:Bind CurrentRankName}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{x:Bind Encounters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EncounterRowViewModel">
                                        <Grid Padding="4,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind When}" Opacity="0.8" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Image Source="{x:Bind RankIcon}" Width="22" Height="22" />
                                                <TextBlock Text="{x:Bind RankName}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Agent}" Opacity="0.85" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind AllyText}" Opacity="0.6" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
