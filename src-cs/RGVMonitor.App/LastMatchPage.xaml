<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RGVMonitor.App.LastMatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RGVMonitor.App.ViewModels">

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Partida anterior" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="22" Height="22" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Recargar" VerticalAlignment="Center"
                    Click="OnReloadClicked"
                    Command="{x:Bind ViewModel.LoadCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="4">
            <ListView ItemsSource="{x:Bind ViewModel.Players, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LastMatchRowViewModel">
                        <Grid Padding="16,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2"
                                       Fill="{x:Bind TeamBrush}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind AgentIcon}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{x:Bind Agent}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Image Source="{x:Bind RankIcon}" Width="26" Height="26" />
                                <TextBlock Text="{x:Bind RankName}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Kills/muertes/asistencias de la partida. -->
                            <TextBlock Grid.Column="3" Text="{x:Bind Kda}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       ToolTipService.ToolTip="Bajas / muertes / asistencias" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Rr}" Opacity="0.75"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{x:Bind AllyText}" Opacity="0.6"
                                       FontSize="12" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="6" Spacing="3" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                               Visibility="{x:Bind NormalNameVisibility}"
                                               ToolTipService.ToolTip="Clic para copiar el nombre"
                                               Tapped="OnCopyName" />
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                               FontWeight="Bold" Foreground="#FFF5C83C"
                                               Visibility="{x:Bind HiddenNameVisibility}"
                                               ToolTipService.ToolTip="Clic para copiar el nombre"
                                               Tapped="OnCopyName" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Background="{x:Bind NoteBrush, Mode=OneWay}"
                                            CornerRadius="4" Padding="6,1"
                                            Visibility="{x:Bind NoteChipVisibility, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind NoteLabel, Mode=OneWay}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{x:Bind NoteText, Mode=OneWay}"
                                               Visibility="{x:Bind NoteTextVisibility, Mode=OneWay}"
                                               FontSize="11" Opacity="0.8"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="7" Click="OnNotePlayer"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="8" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Marcar / nota">
                                <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <InfoBar x:Name="CopyToast" Grid.Row="1" Severity="Success" IsClosable="True"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,24" MaxWidth="360" />
    </Grid>
</Page>
