<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RGVMonitor.App.LastMatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RGVMonitor.App.ViewModels">

    <Page.Resources>
        <!-- Fila de jugador (la usan las dos secciones: tu equipo y rivales). -->
        <DataTemplate x:Key="LastMatchRowTemplate" x:DataType="vm:LastMatchRowViewModel">
            <Grid Padding="16,8" ColumnSpacing="10" Margin="0,1"
                  Background="{x:Bind RowBackground}" CornerRadius="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0" Style="{StaticResource TeamStripeStyle}"
                           Fill="{x:Bind TeamBrush}" />

                <Border Grid.Column="1" Style="{StaticResource AvatarBorderStyle}"
                        ToolTipService.ToolTip="{x:Bind Agent}">
                    <Image Source="{x:Bind AgentIcon}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid>
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource PlayerNameTextStyle}"
                                       Visibility="{x:Bind NormalNameVisibility}"
                                       ToolTipService.ToolTip="Clic para copiar el nombre"
                                       Tapped="OnCopyName" />
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource HiddenPlayerNameTextStyle}"
                                       Visibility="{x:Bind HiddenNameVisibility}"
                                       ToolTipService.ToolTip="Nombre oculto · clic para copiarlo"
                                       Tapped="OnCopyName" />
                        </Grid>
                        <!-- MVP de la partida / del otro equipo -->
                        <Border Style="{StaticResource NoteChipStyle}" VerticalAlignment="Center"
                                Background="{x:Bind MvpBrush, Mode=OneWay}"
                                Visibility="{x:Bind MvpVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind MvpText, Mode=OneWay}" FontSize="10"
                                       FontWeight="Bold" Foreground="#FF1A1A1A" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Agent}" Style="{StaticResource CaptionTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource NoteChipStyle}"
                                Background="{x:Bind NoteBrush, Mode=OneWay}"
                                Visibility="{x:Bind NoteChipVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind NoteLabel, Mode=OneWay}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <TextBlock Text="{x:Bind NoteText, Mode=OneWay}"
                                   Visibility="{x:Bind NoteTextVisibility, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind NoteText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Image Source="{x:Bind RankIcon}" Width="28" Height="28" />
                    <TextBlock Text="{x:Bind RankName}" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="4" Text="{x:Bind Acs}" Style="{StaticResource StatTextStyle}" />
                <TextBlock Grid.Column="5" Text="{x:Bind Kda}" Style="{StaticResource MutedStatTextStyle}" />
                <TextBlock Grid.Column="6" Text="{x:Bind KdRatio}" Foreground="{x:Bind KdBrush}"
                           Style="{StaticResource StatTextStyle}" />
                <TextBlock Grid.Column="7" Text="{x:Bind Adr}" Style="{StaticResource MutedStatTextStyle}" />
                <TextBlock Grid.Column="8" Text="{x:Bind Hs}" Foreground="{x:Bind HsBrush}"
                           Style="{StaticResource StatTextStyle}" />
                <TextBlock Grid.Column="9" Text="{x:Bind FirstKills}" Style="{StaticResource MutedStatTextStyle}" />

                <Button Grid.Column="10" Click="OnNotePlayer"
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Marcar o anotar jugador"
                        ToolTipService.ToolTip="Marcar / nota">
                    <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Cifra del banner: etiqueta pequeña arriba, valor debajo. -->
        <Style x:Key="BannerLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="BannerValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid Style="{StaticResource PageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="-16" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Partida anterior" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="20" Height="20" VerticalAlignment="Center" />
            <Button Grid.Column="2" VerticalAlignment="Center"
                    Click="OnReloadClicked"
                    Command="{x:Bind ViewModel.LoadCommand}"
                    AutomationProperties.Name="Recargar partida anterior"
                    ToolTipService.ToolTip="Volver a cargar la última partida">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Recargar" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Banner de resultado: mapa de fondo, marcador y tu rendimiento. Siempre en
             oscuro para que el texto se lea sobre la imagen en cualquier tema.
             Altura fija: con Auto la imagen del mapa pide su tamaño natural y
             empuja la tabla fuera de la pantalla. -->
        <Border Grid.Row="1" RequestedTheme="Dark" CornerRadius="12" Height="136"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="#FF16181D"
                Visibility="{x:Bind ViewModel.SummaryVisibility, Mode=OneWay}">
            <Grid>
                <Image Source="{x:Bind ViewModel.MapSplash, Mode=OneWay}" Stretch="UniformToFill"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F216181D" Offset="0" />
                            <GradientStop Color="#B316181D" Offset="0.45" />
                            <GradientStop Color="#E616181D" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Padding="24,18,24,20" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Resultado + marcador + mapa -->
                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{x:Bind ViewModel.ResultText, Mode=OneWay}"
                                       Foreground="{x:Bind ViewModel.ResultBrush, Mode=OneWay}"
                                       FontSize="30" FontWeight="Bold" CharacterSpacing="-20" />
                            <TextBlock FontSize="30" FontWeight="SemiBold" CharacterSpacing="-20"
                                       VerticalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.AllyScore, Mode=OneWay}" Foreground="{StaticResource AllyBrush}" />
                                <Run Text=" : " Foreground="#80FFFFFF" />
                                <Run Text="{x:Bind ViewModel.EnemyScore, Mode=OneWay}" Foreground="{StaticResource EnemyBrush}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock>
                            <Run Text="{x:Bind ViewModel.MapName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  ·  " Foreground="#80FFFFFF" />
                            <Run Text="{x:Bind ViewModel.MatchMeta, Mode=OneWay}" Foreground="#B3FFFFFF" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Tu rendimiento: RR + rango y cifras clave -->
                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind ViewModel.RrDelta, Mode=OneWay}"
                                       Foreground="{x:Bind ViewModel.RrDeltaBrush, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.RrVisibility, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                            <Image Source="{x:Bind ViewModel.RankAfterIcon, Mode=OneWay}"
                                   Width="28" Height="28" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.RankAfter, Mode=OneWay}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="22" HorizontalAlignment="Right"
                                    Visibility="{x:Bind ViewModel.SelfStatsVisibility, Mode=OneWay}">
                            <StackPanel ToolTipService.ToolTip="Puntuación de combate media por ronda">
                                <TextBlock Text="ACS" Style="{StaticResource BannerLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelfAcs, Mode=OneWay}" Style="{StaticResource BannerValueStyle}" />
                            </StackPanel>
                            <StackPanel ToolTipService.ToolTip="Bajas / muertes / asistencias">
                                <TextBlock Text="K / D / A" Style="{StaticResource BannerLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelfKda, Mode=OneWay}" Style="{StaticResource BannerValueStyle}" />
                            </StackPanel>
                            <StackPanel ToolTipService.ToolTip="Daño medio por ronda">
                                <TextBlock Text="ADR" Style="{StaticResource BannerLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelfAdr, Mode=OneWay}" Style="{StaticResource BannerValueStyle}" />
                            </StackPanel>
                            <StackPanel ToolTipService.ToolTip="Porcentaje de impactos en la cabeza">
                                <TextBlock Text="HS" Style="{StaticResource BannerLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelfHs, Mode=OneWay}" Style="{StaticResource BannerValueStyle}" />
                            </StackPanel>
                            <StackPanel ToolTipService.ToolTip="Primeras bajas de ronda">
                                <TextBlock Text="1ª baja" Style="{StaticResource BannerLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelfFirstKills, Mode=OneWay}" Style="{StaticResource BannerValueStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Tabla por equipos -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}"
                Visibility="{x:Bind ViewModel.TableVisibility, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource TableHeaderStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="JUGADOR" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="RANGO" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="ACS" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Puntuación de combate media por ronda" />
                        <TextBlock Grid.Column="5" Text="K / D / A" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Bajas / muertes / asistencias" />
                        <TextBlock Grid.Column="6" Text="KD" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Bajas por muerte en esta partida" />
                        <TextBlock Grid.Column="7" Text="ADR" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Daño medio por ronda" />
                        <TextBlock Grid.Column="8" Text="HS" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Porcentaje de impactos en la cabeza" />
                        <TextBlock Grid.Column="9" Text="1ªB" Style="{StaticResource NumericColumnHeaderTextStyle}"
                                   ToolTipService.ToolTip="Primeras bajas de ronda" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="6,4,6,8">
                    <StackPanel>
                        <!-- Tu equipo -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,10,16,6">
                            <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{StaticResource AllyBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AllyHeader, Mode=OneWay}"
                                       Style="{StaticResource CardLabelTextStyle}"
                                       Foreground="{StaticResource AllyBrush}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AllyPlayers, Mode=OneWay}"
                                      ItemTemplate="{StaticResource LastMatchRowTemplate}">
                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                                </TransitionCollection>
                            </ItemsControl.ItemContainerTransitions>
                        </ItemsControl>

                        <!-- Rivales -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,16,16,6">
                            <Ellipse Style="{StaticResource LegendDotStyle}" Fill="{StaticResource EnemyBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EnemyHeader, Mode=OneWay}"
                                       Style="{StaticResource CardLabelTextStyle}"
                                       Foreground="{StaticResource EnemyBrush}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EnemyPlayers, Mode=OneWay}"
                                      ItemTemplate="{StaticResource LastMatchRowTemplate}">
                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                                </TransitionCollection>
                            </ItemsControl.ItemContainerTransitions>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <InfoBar x:Name="CopyToast" Grid.Row="2" Severity="Success" IsClosable="True"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,24" MaxWidth="360" />
    </Grid>
</Page>
